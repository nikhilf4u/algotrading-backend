type OptionChainDto
{
    price:Float
    openInterest:Int
    time:String
    strikePrice:String
}
input OptionChainInputDto
{
    id:Int
    price:Float
    openInterest:Int
    time:String
    strikePrice:String
    index:String
    impliedVolatility:Float
    underlyingValue:Int
    daysLeftToExpire:Int
    totalTradedVolume:Int
}
type OptionChainForStrikePriceDto{
    priceList:[Float]
    openInterestList:[Int]
    timeList:[String]
}
type OIChangeDto{
    oiChangeList:[Int]
    timeList:[String]
}

type StrikePriceOutputDto{
    strikePrice:String
    delta:Float
    theta:Float
    gamma:Float
    vega:Float
    profit:Float
}

type Query{
    getOptionChainData : [OptionChainDto]
    getOptionChainDataForStrikePrice(strikePrice:String):OptionChainForStrikePriceDto
    getChangeInOIForIndex(index:String):OIChangeDto
    getDataForStrikePriceSelection(indexType:String,actionType:String,optionType:String):[StrikePriceOutputDto]
    getChangeInOpenInterestForStrikePrice(strikePrice:Int):OIChangeDto
}
type Mutation{
    saveOptionChainData(optionChainInputDtos:[OptionChainInputDto]) : Boolean
}
