type OptionChainDto
{
    price:Float
    openInterest:Int
    time:String
    strikePrice:String
}
input OptionChainInputDto
{
    id:Int
    price:Float
    openInterest:Int
    time:String
    strikePrice:String
    index:String
}
type OptionChainForStrikePriceDto{
    priceList:[Float]
    openInterestList:[Int]
    timeList:[String]
}
type OIChangeDto{
    oiChangeList:[Int]
    timeList:[String]
}

type Query{
    getOptionChainData : [OptionChainDto]
    getOptionChainDataForStrikePrice(strikePrice:String):OptionChainForStrikePriceDto
    getChangeInOIForIndex(index:String):OIChangeDto
}
type Mutation{
    saveOptionChainData(optionChainInputDtos:[OptionChainInputDto]) : Boolean
}
